{
  "name": "Mokkify",
  "version": "2.0.0",
  "repository": "git@github.com:wavix/mokkify.git",
  "author": "Wavix Inc. <product@wavix.com>",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "npx eslint ./src --quiet --color",
    "type": "tsc --project tsconfig.json --noEmit",
    "format": "prettier --write './src/**/*.{js,ts,json,tsx,scss}'",
    "start": "next start -p 3000",
    "cli": "node -r @swc-node/register ./src/app/database/cli.ts",
    "migrate": "node -r @swc-node/register ./src/app/database/migrate.ts",
    "migrate:create": "pnpm migrate create --folder ./src/app/migrations --name",
    "openapi:validate": "redocly lint public/openapi.yaml && node scripts/check-openapi-coverage.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "dayjs": "^1.11.10",
    "embla-carousel-react": "^8.6.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-unused-imports": "^4.4.1",
    "input-otp": "^1.5.0",
    "joi": "^18.2.3",
    "jose": "^6.2.9",
    "js-yaml": "^5.3.0",
    "lucide-react": "^1.32.0",
    "next": "16.3.1",
    "next-themes": "^0.4.6",
    "pg-hstore": "^2.3.4",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.3",
    "react-use": "^17.4.0",
    "react18-json-view": "^0.2.10",
    "recharts": "3.8.0",
    "sequelize": "^6.34.0",
    "sonner": "^2.0.8",
    "sqlite3": "^6.0.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.67.0",
    "uuid": "^14.0.2",
    "vaul": "^1.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@redocly/cli": "^2.46.2",
    "@svgr/webpack": "^8.1.0",
    "@swc-node/register": "^1.12.1",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.1",
    "@types/js-yaml": "^4.0.9",
    "autoprefixer": "^10.4.16",
    "lint-staged": "^17.3.0",
    "postcss": "^8.4.31",
    "prettier": "^3.0.3",
    "sequelize-cli": "^6.6.2",
    "umzug": "^3.8.0"
  },
  "pnpm": {
    "neverBuiltDependencies": []
  },
  "simple-pre-commit": "npx lint-staged",
  "lint-staged": {
    "*.{ts,js}": [
      "./node_modules/.bin/prettier -w './src/**/*.{ts,tsx}' ",
      "./node_modules/.bin/eslint ./src/ --quiet --color --fix"
    ],
    "*.json": [
      "prettier --write"
    ]
  }
}
